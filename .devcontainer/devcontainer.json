{
    "name": "ovms-admin",
    "dockerComposeFile": [
        "../docker-compose.dev.yml"
    ],
    "service": "laravel",
    "workspaceFolder": "/workspaces/ovms-admin/laravel",
    "customizations": {
        "vscode": {
            "settings": {
                "mcp": {
                    "servers": {
                        "laravel-boost": {
                            "type": "stdio",
                            "command": "php",
                            "args": [
                                "artisan",
                                "boost:mcp"
                            ],
                            "cwd": "/workspaces/ovms-admin/laravel"
                        }
                    }
                }
            }
        }
    }
}