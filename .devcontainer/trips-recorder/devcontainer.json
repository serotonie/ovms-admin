// https://aka.ms/devcontainer.json. 
{
	"name": "OVMS Admin Trips Recorder",
	"initializeCommand": "docker compose down --remove-orphans; sudo chown -R 1000:33 ./laravel; sudo chmod -R g=u ./laravel; docker compose -f ./docker-compose.yml -f ./docker-compose.dev.yml -f ./.devcontainer/trips-recorder/docker-compose.yml config > ./docker-compose.rendered.yml",
	"dockerComposeFile": [
		"../../docker-compose.rendered.yml"
	],
	"service": "trips-recorder",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/python/trips-recorder",
	"remoteUser": "worker",
	"postAttachCommand": "cd /workspaces/${localWorkspaceFolderBasename}/python/trips-recorder && python -m venv venv; source venv/bin/activate; pip install -r requirements.txt; /bin/bash; python devtools/setup_mqtt_explorer.py",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.pylint",
				"ms-python.vscode-pylance",
				"exaland.mqtt-explorer-vscode"
			],
			"settings": {
				"pylint.lintOnChange": true
			}
		}
	}
}